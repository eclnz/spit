# Copies each note after a pause, long enough to stop the controller while the jobs are queued or running.
root data
source note : Text .txt [name]
path note: {name}.txt
default path: out/{@product}/{name}.txt
operation slow(note: Text) -> Text .txt
command slow: sh -c 'sleep 20; cp "$1" "$2"' sh {note} {@output}
copied = slow(note)

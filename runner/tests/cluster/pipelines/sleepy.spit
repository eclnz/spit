# Copies a note after 150 seconds, longer than a 2-minute limit: Slurm stops it at its limit until a retry gives it
# twice the time.
root data
source note : Text .txt [name]
path note: {name}.txt
default path: out/{@product}/{name}.txt
operation sleepy(note: Text) -> Text .txt
command sleepy: sh -c 'sleep 150; cp "$1" "$2"' sh {note} {@output}
copied = sleepy(note)

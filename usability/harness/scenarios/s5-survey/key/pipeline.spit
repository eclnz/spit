source responses : Raw [region, wave]
path responses: responses/{region}/wave{wave}.csv

stage ingest:
    operation clean_responses(raw: Raw) -> Table
    command clean_responses: clean_responses {raw} {output}
    path clean: build/ingest/clean/{region}/wave{wave}.csv
    clean = clean_responses(responses)

stage model:
    operation fit_panel(waves: many Table) -> (coef: Coef, diag: Diag)
    verify fit_panel: validate_panel {waves}
    command fit_panel: fit_panel --coef {coef} --diag {diag} {waves}
    path coef: build/model/coef/{region}.json
    path diag: build/model/diag/{region}.txt
    coef, diag = fit_panel(clean @ vary(wave))

stage publish:
    operation plot_region(coef: Coef) -> Chart
    command plot_region: plot_region {coef} {output}
    path chart: build/publish/chart/{region}.svg
    chart = plot_region(coef)

    operation national_table(coefs: many Coef) -> Table
    command national_table: national_table --out {output} {coefs}
    path national: build/publish/national.csv
    national = national_table(coef @ vary(region))

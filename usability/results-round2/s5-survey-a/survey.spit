source responses [region, wave]
path responses: data/responses/{region}/wave{wave}.csv

stage ingest:
    operation clean(raw) -> Clean
    command clean: clean_responses {raw} {output}
    clean_wave = clean(responses)
    path clean_wave: build/ingest/clean/{region}/wave{wave}.csv

stage model:
    operation fit(waves: many Clean) -> (coef: Coef, diag: Diag) @ drop(wave)
    verify fit: validate_panel {waves}
    command fit: fit_panel --coef {coef} --diag {diag} {waves}
    coef, diag = fit(clean_wave @ vary(wave))
    path coef: build/model/coef/{region}.json
    path diag: build/model/diag/{region}.txt

stage publish:
    operation plot(coef: Coef) -> Chart
    command plot: plot_region {coef} {output}
    chart = plot(coef)
    path chart: build/publish/chart/{region}.svg

    operation table(coefs: many Coef) -> Table @ drop(region)
    command table: national_table --out {output} {coefs}
    national = table(coef @ vary(region))
    path national: build/publish/national.csv

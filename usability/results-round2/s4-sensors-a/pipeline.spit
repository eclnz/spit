source raw [station, day]
path raw: raw/{station}/{day}.csv

source calibration [station, revision]
path calibration: calibration/{station}/rev{revision}.json

source baseline [station, date]
path baseline: baseline/{station}/{date}.csv

source site [station]
path site: sites/{station}/site.toml

operation calibrate_reading(reading, cal) -> Clean
command calibrate_reading: calibrate --cal {cal} --in {reading} --out {output}
clean = calibrate_reading(raw, calibration @ where(revision=3))
path clean: clean/{station}/{day}.csv

operation compare_reading(reading, reference) -> Anomaly
command compare_reading: anomaly {reading} {reference} {output}
anomalies = compare_reading(clean, baseline @ same(station))
path anomalies: anomalies/{station}/{day}.csv

operation make_report(metadata, days: many Anomaly) -> Report @ drop(day)
command make_report: stationreport --site {metadata} --out {output} {days}
report = make_report(site, anomalies @ vary(day))
path report: reports/{station}.html

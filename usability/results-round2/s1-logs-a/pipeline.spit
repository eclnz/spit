source log : Log [server, date]
path log: logs/{server}/{date}.log

operation digest(input: Log) -> Digest
command digest: logdigest --in {input} --out {output}
digest = digest(log)
path digest: digests/{server}/{date}.json

operation rollup(digests: many Digest) -> Report @ drop(date)
command rollup: rollup --out {output} {digests}
report = rollup(digest @ vary(date))
path report: reports/{server}/week.json

operation fleet(reports: many Report) -> Fleet @ drop(server)
command fleet: fleetsum {reports} -o {output}
fleet_report = fleet(report @ vary(server))
path fleet_report: reports/fleet.json

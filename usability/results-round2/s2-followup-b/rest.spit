source bold [sub, ses, run]
source t1w [sub, ses]

path bold: sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_task-rest_run-{run}_bold.nii.gz
path t1w: sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_T1w.nii.gz
path mc: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_mc.nii.gz
path brain: derivatives/sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_brain.nii.gz
path coregistered: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_coreg.nii.gz
path avg: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_avg.nii.gz
path qc: derivatives/sub-{sub}/ses-{ses}/sub-{sub}_ses-{ses}_qc.html
path long: derivatives/sub-{sub}/sub-{sub}_long.nii.gz

operation motion_correct(input) -> Image
command motion_correct: motioncorr {input} {output}
mc = motion_correct(bold)

operation extract(input) -> Image
command extract: bet {input} {output}
brain = extract(t1w)

operation register(ref, input) -> Image
command register: coreg --ref {ref} --in {input} --out {output}
coregistered = register(brain, mc)

operation average(inputs: many) -> Image @ drop(run)
command average: sessionavg --out {output} {inputs}
avg = average(coregistered @ vary(run))

operation report(t1: Image, scans: many Image) -> Report @ drop(run)
command report: qcreport --t1 {t1} --out {output} {scans}
qc = report(brain, coregistered @ vary(run))

operation combine(inputs: many) -> Image @ drop(ses) @ min(2)
command combine: longitudinal --out {output} {inputs}
long = combine(avg @ vary(ses))

source reading : Reading [station, day]
path reading: raw/{station}/{day}.csv

source calibration : Calibration [station, revision]
path calibration: calibration/{station}/rev{revision}.json

source baseline : Baseline [station, recorded]
path baseline: baseline/{station}/{recorded}.csv

source site : Site [station]
path site: sites/{station}/site.toml

operation calibrate_reading(cal: Calibration, reading: Reading) -> Clean
command calibrate_reading: calibrate --cal {cal} --in {reading} --out {output}
clean = calibrate_reading(calibration @ where(revision=3), reading)
path clean: clean/{station}/{day}.csv

operation find_anomaly(clean: Clean, baseline: Baseline) -> Anomaly
command find_anomaly: anomaly {clean} {baseline} {output}
anomalies = find_anomaly(clean, baseline @ same(station))
path anomalies: anomalies/{station}/{day}.csv

operation make_report(site: Site, anomalies: many Anomaly) -> Report @ drop(day)
command make_report: stationreport --site {site} --out {output} {anomalies}
reports = make_report(site, anomalies @ vary(day))
path reports: reports/{station}.html

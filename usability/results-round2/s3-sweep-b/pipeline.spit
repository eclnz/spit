source model : Model [model]
path model: models/{model}.pt

source config : Config [config]
path config: configs/{config}.yaml

source seed : Seed [config, seed]
path seed: sweep/{config}/seed-{seed}.json

source testset : Testset
path testset: eval/testset.parquet

operation train_model(model: Model, config: Config, seed_file: Seed) -> Weights
command train_model: train --model {model} --config {config} --seed-file {seed_file} --out {output}
weights = train_model(model @ each(model), config, seed)
path weights: runs/{model}/{config}/seed-{seed}/weights.pt

operation evaluate_run(weights: Weights, testset: Testset) -> Metrics
command evaluate_run: evaluate --weights {weights} --testset {testset} --out {output}
metrics = evaluate_run(weights, testset)
path metrics: runs/{model}/{config}/seed-{seed}/metrics.json

operation summarise_runs(metrics: many Metrics) -> Summary @ drop(seed)
command summarise_runs: summarise --out {output} {metrics}
summary = summarise_runs(metrics @ vary(seed))
path summary: summaries/{model}/{config}.json

operation make_leaderboard(summaries: many Summary) -> Board @ drop(config)
command make_leaderboard: leaderboard --out {output} {summaries}
board = make_leaderboard(summary @ vary(config))
path board: leaderboards/{model}.csv

operation compare(boards: many Board) -> Comparison @ drop(model)
command compare: compare_models {boards} --out {output}
comparison = compare(board @ vary(model))
path comparison: leaderboard.csv

source reading : Reading [station, day]
path reading: raw/{station}/{day}.csv

source calibration : Calibration [station, revision]
path calibration: calibration/{station}/rev{revision}.json

source baseline : Baseline [station, recorded]
path baseline: baseline/{station}/{recorded}.csv

source site : Site [station]
path site: sites/{station}/site.toml

operation calibrate(cal: Calibration, input: Reading) -> Clean
command calibrate: calibrate --cal {cal} --in {input} --out {output}
clean = calibrate(calibration @ where(revision=3), reading)
path clean: clean/{station}/{day}.csv

operation detect(input: Clean, baseline: Baseline) -> Anomaly
command detect: anomaly {input} {baseline} {output}
anomalies = detect(clean, baseline @ same(station))
path anomalies: anomalies/{station}/{day}.csv

operation report(site: Site, anomalies: many Anomaly) -> Report @ drop(day)
command report: stationreport --site {site} --out {output} {anomalies}
reports = report(site, anomalies @ vary(day))
path reports: reports/{station}.html

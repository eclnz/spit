source bold : Image [sub, ses, run]
source t1w : Image [sub, ses]

path bold: sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_task-rest_run-{run}_bold.nii.gz
path t1w: sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_T1w.nii.gz
path mc: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_mc.nii.gz
path brain: derivatives/sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_brain.nii.gz
path coregistered: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_coreg.nii.gz
path avg: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_avg.nii.gz
path long: derivatives/sub-{sub}/sub-{sub}_long.nii.gz

operation motion_correct(bold: Image) -> Image
command motion_correct: motioncorr {bold} {output}
mc = motion_correct(bold)

operation brain_extract(t1w: Image) -> Image
command brain_extract: bet {t1w} {output}
brain = brain_extract(t1w)

operation coregister(mc: Image, brain: Image) -> Image
command coregister: coreg --ref {brain} --in {mc} --out {output}
coregistered = coregister(mc, brain)

operation session_average(runs: many Image) -> Image @ drop(run)
command session_average: sessionavg --out {output} {runs}
avg = session_average(coregistered)

operation longitudinal_average(sessions: many Image) -> Image @ drop(ses)
command longitudinal_average: longitudinal --out {output} {sessions}
long = longitudinal_average(avg)

source bold [sub, ses, run]
source t1w [sub, ses]
path bold: data/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_task-rest_run-{run}_bold.nii.gz
path t1w: data/sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_T1w.nii.gz

path: derivatives/sub-{sub}[/ses-{ses}][/{@stage}]/{@labels}_{@product}
ext: .nii.gz

operation motion_correct(bold: Image) -> Image
command motion_correct: motioncorr {bold} {output}
operation extract(t1w: Image) -> Image
command extract: bet {t1w} {output}
operation register(mc: Image, brain: Image) -> Image
command register: coreg --ref {brain} --in {mc} --out {output}
operation run_average(runs: many Image) -> Image
command run_average: sessionavg --out {output} {runs}
operation combine(sessions: many Image) -> Image
command combine: longitudinal --out {output} {sessions}

stage func:
    mc = motion_correct(bold)
    coreg = register(mc, brain)
    avg = run_average(coreg @ vary(run))
stage anat:
    brain = extract(t1w)
long = combine(avg @ vary(ses))

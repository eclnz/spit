source bold [sub, ses, run]
path bold: sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_task-rest_run-{run}_bold.nii.gz

source t1w [sub, ses]
path t1w: sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_T1w.nii.gz

operation motioncorr(input) -> Image
command motioncorr: motioncorr {input} {output}
mc = motioncorr(bold)
path mc: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_mc.nii.gz

operation bet(input) -> Image
command bet: bet {input} {output}
brain = bet(t1w)
path brain: derivatives/sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_brain.nii.gz

operation coreg(ref, input) -> Image
command coreg: coreg --ref {ref} --in {input} --out {output}
registered = coreg(brain, mc)
path registered: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_coreg.nii.gz

operation sessionavg(inputs: many) -> Image @ drop(run)
command sessionavg: sessionavg --out {output} {inputs}
avg = sessionavg(registered)
path avg: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_avg.nii.gz

operation longitudinal(inputs: many) -> Image @ drop(ses)
command longitudinal: longitudinal --out {output} {inputs}
long = longitudinal(avg)
path long: derivatives/sub-{sub}/sub-{sub}_long.nii.gz

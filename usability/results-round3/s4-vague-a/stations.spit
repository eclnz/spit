source reading [station, day]
path reading: raw/{station}/{day}.csv

source calibration [station, revision]
path calibration: calibration/{station}/rev{revision}.json

source baseline [station, recorded]
path baseline: baseline/{station}/{recorded}.csv

source site [station]
path site: sites/{station}/site.toml

operation calibrate_reading(calibration, reading) -> Clean
command calibrate_reading: calibrate --cal {calibration} --in {reading} --out {output}
clean = calibrate_reading(calibration @ where(revision=3), reading)
path clean: clean/{station}/{day}.csv

operation find_anomaly(clean, baseline) -> Anomaly
command find_anomaly: anomaly {clean} {baseline} {output}
anomalies = find_anomaly(clean, baseline @ same(station))
path anomalies: anomalies/{station}/{day}.csv

operation station_report(site, anomalies: many Anomaly) -> Report @ drop(day)
command station_report: stationreport --site {site} --out {output} {anomalies}
reports = station_report(site, anomalies @ vary(day))
path reports: reports/{station}.html

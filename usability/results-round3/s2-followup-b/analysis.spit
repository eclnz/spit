source bold : Image [sub, ses, run]
source t1w : Image [sub, ses]

operation motion_correct(input: Image) -> Image
command motion_correct: motioncorr {input} {output}
mc = motion_correct(bold)
path mc: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_mc.nii.gz

operation brain_extract(input: Image) -> Image
command brain_extract: bet {input} {output}
brain = brain_extract(t1w)
path brain: derivatives/sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_brain.nii.gz

operation coregister(ref: Image, input: Image) -> Image
command coregister: coreg --ref {ref} --in {input} --out {output}
coregistered = coregister(brain, mc)
path coregistered: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_coreg.nii.gz

operation average(inputs: many Image) -> Image
command average: sessionavg --out {output} {inputs}
avg = average(coregistered @ vary(run))
path avg: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_avg.nii.gz

operation quality_report(t1: Image, runs: many Image) -> Report
command quality_report: qcreport --t1 {t1} --out {output} {runs}
qc = quality_report(brain, coregistered @ vary(run))
path qc: derivatives/sub-{sub}/ses-{ses}/sub-{sub}_ses-{ses}_qc.html

operation combine(inputs: many Image) -> Image
command combine: longitudinal --out {output} {inputs}
long = combine(avg @ vary(ses))
path long: derivatives/sub-{sub}/sub-{sub}_long.nii.gz

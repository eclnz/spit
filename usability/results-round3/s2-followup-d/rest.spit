source t1w [sub, ses]
source bold [sub, ses, run]

path t1w: sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_T1w.nii.gz
path bold: sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_task-rest_run-{run}_bold.nii.gz
path mc: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_mc.nii.gz
path brain: derivatives/sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_brain.nii.gz
path coregistered: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_run-{run}_coreg.nii.gz
path average: derivatives/sub-{sub}/ses-{ses}/func/sub-{sub}_ses-{ses}_avg.nii.gz
path qc: derivatives/sub-{sub}/ses-{ses}/sub-{sub}_ses-{ses}_qc.html
path long: derivatives/sub-{sub}/sub-{sub}_long.nii.gz

operation correct(bold) -> Image
command correct: motioncorr {bold} {output}
mc = correct(bold)

operation extract(t1w) -> Image
command extract: bet {t1w} {output}
brain = extract(t1w)

operation register(brain, mc) -> Image
command register: coreg --ref {brain} --in {mc} --out {output}
coregistered = register(brain, mc)

operation average_runs(runs: many Image) -> Image @ drop(run)
command average_runs: sessionavg --out {output} {runs}
average = average_runs(coregistered @ vary(run))

operation report(brain: Image, runs: many Image) -> Report @ drop(run)
command report: qcreport --t1 {brain} --out {output} {runs}
qc = report(brain, coregistered @ vary(run))

operation combine_sessions(sessions: many Image) -> Image @ drop(ses)
command combine_sessions: longitudinal --out {output} {sessions}
long = combine_sessions(average @ vary(ses))

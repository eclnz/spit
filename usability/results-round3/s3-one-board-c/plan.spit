dimensions [model, config, seed]

source base_model [model]
path base_model: models/{model}.pt

source config_file [config]
path config_file: configs/{config}.yaml

source seed_file [config, seed]
path seed_file: sweep/{config}/seed-{seed}.json

source testset
path testset: eval/testset.parquet

operation train(model_file, config_file, seed_file) -> Weights
command train: train --model {model_file} --config {config_file} --seed-file {seed_file} --out {output}
weights = train(base_model @ each(model), config_file, seed_file)
path weights: runs/{model}/{config}/seed-{seed}/weights.pt

operation evaluate(weights_file, testset_file) -> Metrics
command evaluate: evaluate --weights {weights_file} --testset {testset_file} --out {output}
metrics = evaluate(weights, testset)
path metrics: runs/{model}/{config}/seed-{seed}/metrics.json

operation summarise(metrics_files: many Metrics) -> Summary
command summarise: summarise --out {output} {metrics_files}
summary = summarise(metrics @ vary(seed))
path summary: summaries/{model}/{config}.json

operation make_leaderboard(summaries: many Summary) -> Table
command make_leaderboard: leaderboard --out {output} {summaries}
board = make_leaderboard(summary @ vary(model, config))
path board: leaderboard.csv

source log : Log [server, date]
path log: data/logs/{server}/{date}.log

operation make_digest(log: Log) -> Digest
command make_digest: logdigest --in {log} --out {output}
digest = make_digest(log)
path digest: digests/{server}/{date}.json

operation roll(digests: many Digest) -> Report @ drop(date)
command roll: rollup --out {output} {digests}
week = roll(digest @ vary(date))
path week: reports/{server}/week.json

operation combine(reports: many Report) -> Fleet @ drop(server)
command combine: fleetsum {reports} -o {output}
fleet = combine(week @ vary(server))
path fleet: reports/fleet.json

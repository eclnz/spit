# Weekly server log reports.
source log : Log [server, date]
path log: logs/{server}/{date}.log

operation logdigest(log: Log) -> Digest
command logdigest: logdigest --in {log} --out {output}
digest = logdigest(log)
path digest: digests/{server}/{date}.json

operation rollup(digests: many Digest) -> Report @ drop(date)
command rollup: rollup --out {output} {digests}
report = rollup(digest @ vary(date))
path report: reports/{server}/week.json

operation fleetsum(reports: many Report) -> Fleet @ drop(server)
command fleetsum: fleetsum {reports} -o {output}
fleet = fleetsum(report @ vary(server))
path fleet: reports/fleet.json

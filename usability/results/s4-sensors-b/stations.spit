source reading : Reading [station, day]
source calibration : Calibration [station, revision]
source baseline : Baseline [station, recorded]
source site : Site [station]

path reading: data/raw/{station}/{day}.csv
path calibration: data/calibration/{station}/rev{revision}.json
path baseline: data/baseline/{station}/{recorded}.csv
path site: data/sites/{station}/site.toml

path clean: clean/{station}/{day}.csv
path anomaly: anomalies/{station}/{day}.csv
path report: reports/{station}.html

operation calibrate(reading: Reading, cal: Calibration) -> Clean
command calibrate: calibrate --cal {cal} --in {reading} --out {output}
clean = calibrate(reading, calibration @ where(revision=3))

operation anomaly(clean: Clean, baseline: Baseline) -> Anomaly
command anomaly: anomaly {clean} {baseline} {output}
anomaly = anomaly(clean, baseline @ same(station))

operation stationreport(days: many Anomaly, site: Site) -> Report @ drop(day)
command stationreport: stationreport --site {site} --out {output} {days}
report = stationreport(anomaly @ vary(day), site)

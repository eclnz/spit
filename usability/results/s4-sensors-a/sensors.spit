# Station calibration reports. Paths are relative to the dataset root (data/).

source reading : Reading [station, day]
path reading: raw/{station}/{day}.csv

source calibration : Calibration [station, rev]
path calibration: calibration/{station}/rev{rev}.json

source baseline : Baseline [station, date]
path baseline: baseline/{station}/{date}.csv

source site : Site [station]
path site: sites/{station}/site.toml

operation calibrate(reading: Reading, cal: Calibration) -> Reading
command calibrate: calibrate --cal {cal} --in {reading} --out {output}
clean = calibrate(reading, calibration @ where(rev=3))
path clean: clean/{station}/{day}.csv

operation anomaly(clean: Reading, baseline: Baseline) -> Anomaly
command anomaly: anomaly {clean} {baseline} {output}
anomalies = anomaly(clean, baseline @ same(station))
path anomalies: anomalies/{station}/{day}.csv

operation stationreport(anomalies: many Anomaly, site: Site) -> Report @ drop(day)
command stationreport: stationreport --site {site} --out {output} {anomalies}
report = stationreport(anomalies @ vary(day), site)
path report: reports/{station}.html

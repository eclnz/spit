# Definitions that the weather versions share.
check nonempty: test -s {@path}

operation average(items: many Mean) -> Mean
command average: awk '{ s += $1; n += 1 } END { printf "%.2f\n", s / n }' {items} > {@output}

# The script that applies a shift is an input, so the caller supplies its own.
operation shifted(script: Script, mean: Mean, shift: Shift) -> Mean
command shifted: python3 {script} {shift} {mean} > {@output}

operation rounded(mean: Mean) -> Mean
command rounded: awk '{ printf "%.1f\n", $1 }' {mean} > {@output}

# A what-if is a mean moved by a scenario's shift, then rounded.
operation what_if(script: Script, mean: Mean, shift: Shift) -> (result: Mean):
    product moved = shifted(script, mean, shift)
    product result = rounded(moved)

# Analytics example: a keyed relation pipeline with several joins and rollups.
# Product names describe query stages. Relation<...,CustomerKey> records the
# join key; repeated K variables in operation signatures enforce compatibility.
source events : Relation<Event,CustomerKey> [tenant, customer, day, event]
source customers : Relation<Customer,CustomerKey> [tenant, customer]
source subscriptions : Relation<Subscription,CustomerKey> [tenant, customer]
source purchases : Relation<Purchase,CustomerKey> [tenant, customer]
source campaigns : Relation<Campaign,CustomerKey> [tenant, customer]

operation clean(events: Relation<Event,K>) -> Relation<Event,K>
clean_events = clean(events)

operation join_customers(events: Relation<Event,K>, customers: Relation<Customer,K>) -> Relation<CustomerEvent,K>
customer_events = join_customers(clean_events, customers)

operation join_subscriptions(events: Relation<CustomerEvent,K>, subscriptions: Relation<Subscription,K>) -> Relation<SubscribedEvent,K>
subscribed_events = join_subscriptions(customer_events, subscriptions)

operation join_purchases(events: Relation<SubscribedEvent,K>, purchases: Relation<Purchase,K>) -> Relation<PurchasedEvent,K>
purchased_events = join_purchases(subscribed_events, purchases)

operation join_campaigns(events: Relation<PurchasedEvent,K>, campaigns: Relation<Campaign,K>) -> Relation<AttributedEvent,K>
attributed_events = join_campaigns(purchased_events, campaigns)

operation aggregate_day(events: many Relation<AttributedEvent,K>) -> Relation<CustomerDayMetric,K>
daily_metrics = aggregate_day(attributed_events @ vary(event))

operation aggregate_customer(days: many Relation<CustomerDayMetric,K>) -> Relation<CustomerMetric,K>
customer_metrics = aggregate_customer(daily_metrics @ vary(day))

operation aggregate_tenant(customers: many Relation<CustomerMetric,CustomerKey>) -> Relation<TenantMetric,TenantKey>
tenant_metrics = aggregate_tenant(customer_metrics @ vary(customer))

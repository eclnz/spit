# This should fail: the second input uses AccountKey, but the join requires
# both relations to share the same key variable K.
source events : Relation<Event,CustomerKey> [tenant, customer, event]
source accounts : Relation<Account,AccountKey> [tenant]

operation join(events: Relation<Event,K>, accounts: Relation<Account,K>) -> Relation<Joined,K>
joined = join(events, accounts)

# SPIT describing SPIT's own build: a learning exercise in dogfooding the
# tool on its own Cargo project rather than on scientific data. There is one
# source artifact, the crate's manifest, and every step runs `cargo` against
# it. `cargo build`, `cargo test`, and `cargo fmt --check` have no
# output-path argument of their own, so `scripts/run_step.sh` wraps each one
# and writes its combined output to the log path SPIT hands it as {output}.
# Run this from the repository root:
#
#   cargo run -- dag examples/self_host/spit_in_spit.spit \
#       --sources examples/self_host/spit_in_spit.sources --paths
#   cargo run -- bash examples/self_host/spit_in_spit.spit \
#       --sources examples/self_host/spit_in_spit.sources > run.sh
#   SPIT_ROOT=. bash run.sh
#
# The generated script formats the crate, then builds, tests, and lints it,
# stopping at the first step that fails; every step's output lands under
# examples/self_host/build/.

source manifest : Manifest []
path manifest: Cargo.toml

path: examples/self_host/build/{product}.log

operation check_fmt(manifest: Manifest) -> FmtReport
command check_fmt: examples/self_host/scripts/run_step.sh {output} cargo fmt --manifest-path {manifest} -- --check

operation build(manifest: Manifest, fmt: FmtReport) -> BuildLog
command build: examples/self_host/scripts/run_step.sh {output} cargo build --manifest-path {manifest}

operation run_tests(manifest: Manifest, build: BuildLog) -> TestReport
command run_tests: examples/self_host/scripts/run_step.sh {output} cargo test --manifest-path {manifest}

operation run_clippy(manifest: Manifest, build: BuildLog) -> LintReport
command run_clippy: examples/self_host/scripts/run_step.sh {output} cargo clippy --manifest-path {manifest} -- -D warnings

fmt_report  = check_fmt(manifest)
build_log   = build(manifest, fmt_report)
test_report = run_tests(manifest, build_log)
lint_report = run_clippy(manifest, build_log)

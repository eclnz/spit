pipeline observatory.spit
root observatory_data

require [org, site, device, window, channel] where raw count>=1
require [org, site, device, channel] where calibration count=1
require [org, site] where clock count=1
require [org, site, window] where window_policy count=1
require [org, site, device] where model count=1
require [org, site] where target count=1
require [org] where policy count=1

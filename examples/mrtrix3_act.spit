# ACT connectome: a logical DAG from raw DWI runs and native T1w.
# These operation names suggest possible MRtrix3 stages, not executable commands.
# DWI preprocessing, T1-to-DWI registration, and node alignment are explicit.
# The parcellation stage represents an anatomical tool such as FreeSurfer;
# convert_labels represents MRtrix3 labelconvert with two shared lookup tables.
products:
    raw_dwi              : RawDWI                       [sub, ses, run]
    reverse_b0           : ReversePEB0                  [sub, ses]
    t1w                  : NativeT1w                    [sub, ses]
    source_lut           : SourceLUT                    []
    target_lut           : TargetLUT                    []
    denoised_dwi         : DenoisedDWI                  [sub, ses, run]
    degibbsed_dwi        : DegibbsedDWI                 [sub, ses, run]
    session_dwi          : ConcatenatedDWI              [sub, ses]
    forward_b0           : ForwardPEB0                  [sub, ses]
    se_epi_pair          : SEEPIPair                    [sub, ses]
    preprocessed_dwi     : MotionDistortionCorrectedDWI [sub, ses]
    corrected_dwi        : BiasCorrectedDWI             [sub, ses]
    session_b0           : DWIReference                 [sub, ses]
    parcellation_t1      : NativeParcellation           [sub, ses]
    nodes_t1             : NodesInT1Space               [sub, ses]
    t1_to_dwi            : RigidT1ToDWITransform        [sub, ses]
    t1w_dwi              : T1wInDWISpace                [sub, ses]
    nodes_dwi            : NodesInDWISpace              [sub, ses]
    five_tt              : FiveTTInDWISpace             [sub, ses]
    gmwmi                : GMWMIInDWISpace              [sub, ses]
    wm_response          : WMResponse                   [sub, ses]
    wm_fod               : WMFODInDWISpace              [sub, ses]
    act_tracks           : TractogramInDWISpace         [sub, ses]
    sift2_weights        : StreamlineWeights            [sub, ses]
    weighted_connectome  : Connectome                   [sub, ses]

operations:
    # Candidate implementations: dwidenoise, mrdegibbs, and dwicat.
    denoise(RawDWI) -> DenoisedDWI
    remove_gibbs(DenoisedDWI) -> DegibbsedDWI
    concatenate_runs(many DegibbsedDWI) -> ConcatenatedDWI
    # b=0 extraction plus mean; mrcat of forward and reverse b=0;
    # dwifslpreproc -rpe_pair; then dwibiascorrect.
    extract_forward_b0(ConcatenatedDWI) -> ForwardPEB0
    combine_pe_pair(ForwardPEB0, ReversePEB0) -> SEEPIPair
    preprocess_dwi(ConcatenatedDWI, SEEPIPair) -> MotionDistortionCorrectedDWI
    bias_correct(MotionDistortionCorrectedDWI) -> BiasCorrectedDWI
    make_session_b0(BiasCorrectedDWI) -> DWIReference
    # Anatomical parcellation, labelconvert, rigid registration, and mrtransform.
    parcellate_t1(NativeT1w) -> NativeParcellation
    convert_labels(NativeParcellation, SourceLUT, TargetLUT) -> NodesInT1Space
    register_t1(NativeT1w, DWIReference) -> RigidT1ToDWITransform
    align_t1(NativeT1w, RigidT1ToDWITransform) -> T1wInDWISpace
    align_nodes(NodesInT1Space, RigidT1ToDWITransform) -> NodesInDWISpace
    # 5ttgen, 5tt2gmwmi, single-output response/FOD estimation, tckgen,
    # tcksift2, and tck2connectome. Multi-output variants await SPIT support.
    make_5tt(T1wInDWISpace) -> FiveTTInDWISpace
    make_gmwmi(FiveTTInDWISpace) -> GMWMIInDWISpace
    estimate_wm_response(BiasCorrectedDWI) -> WMResponse
    estimate_wm_fod(BiasCorrectedDWI, WMResponse) -> WMFODInDWISpace
    track_act(WMFODInDWISpace, FiveTTInDWISpace, GMWMIInDWISpace) -> TractogramInDWISpace
    weight_streamlines(TractogramInDWISpace, WMFODInDWISpace, FiveTTInDWISpace) -> StreamlineWeights
    build_connectome(TractogramInDWISpace, NodesInDWISpace, StreamlineWeights) -> Connectome

pipeline:
    denoised_dwi = denoise(raw_dwi)
    degibbsed_dwi = remove_gibbs(denoised_dwi)
    # Consume run to make one session DWI for subsequent motion correction.
    session_dwi = concatenate_runs(degibbsed_dwi @ vary(run))
    forward_b0 = extract_forward_b0(session_dwi)
    se_epi_pair = combine_pe_pair(forward_b0, reverse_b0)
    preprocessed_dwi = preprocess_dwi(session_dwi, se_epi_pair)
    corrected_dwi = bias_correct(preprocessed_dwi)
    session_b0 = make_session_b0(corrected_dwi)
    parcellation_t1 = parcellate_t1(t1w)
    nodes_t1 = convert_labels(parcellation_t1, source_lut, target_lut)
    t1_to_dwi = register_t1(t1w, session_b0)
    t1w_dwi = align_t1(t1w, t1_to_dwi)
    nodes_dwi = align_nodes(nodes_t1, t1_to_dwi)
    five_tt = make_5tt(t1w_dwi)
    gmwmi = make_gmwmi(five_tt)
    wm_response = estimate_wm_response(corrected_dwi)
    wm_fod = estimate_wm_fod(corrected_dwi, wm_response)
    act_tracks = track_act(wm_fod, five_tt, gmwmi)
    sift2_weights = weight_streamlines(act_tracks, wm_fod, five_tt)
    weighted_connectome = build_connectome(act_tracks, nodes_dwi, sift2_weights)

constraints:
    require raw_dwi count>=2 per [sub, ses]
    require reverse_b0 count=1 per [sub, ses]
    require t1w count=1 per [sub, ses]

# A small pipeline; its inputs are in basic.spitout.
source bold : BOLD [sub, ses, run]
source t1w : T1w [sub, ses]

operation denoise(bold: BOLD) -> DenoisedBOLD
denoised = denoise(bold)

operation register(bold: DenoisedBOLD, anatomy: T1w) -> RegisteredBOLD
registered = register(denoised, t1w)

operation mean(runs: many RegisteredBOLD) -> MeanBOLD
mean_bold = mean(registered @ vary(run))

pipeline mrtrix3_act.spit
root mrtrix3_mock_data

# Where this dataset keeps each main source, in BIDS layout. Companion
# sources follow the NIfTI source path with their own suffix.
inputs:
    raw_dwi: sub-{sub}/ses-{ses}/dwi/sub-{sub}_ses-{ses}_run-{run}_dwi.nii.gz
    reverse_b0: sub-{sub}/ses-{ses}/fmap/sub-{sub}_ses-{ses}_dir-PA_epi.nii.gz
    t1w: sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_T1w.nii.gz
    source_lut: config/source_lut.txt
    target_lut: config/target_lut.txt
    contexts: sub-{sub}/ses-{ses}

require [sub, ses] where raw_dwi count>=2
require [sub, ses] where reverse_b0 count=1
require [sub, ses] where t1w count=1

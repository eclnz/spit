pipeline mrtrix3_act.spit

# Where this dataset keeps each source, in BIDS layout. A sidecars group
# takes one stem, which each member completes with its extension.
path dwi: sub-{sub}/ses-{ses}/dwi/sub-{sub}_ses-{ses}_run-{run}_dwi
path reverse_b0_files: sub-{sub}/ses-{ses}/fmap/sub-{sub}_ses-{ses}_dir-PA_epi
path t1w: sub-{sub}/ses-{ses}/anat/sub-{sub}_ses-{ses}_T1w.nii.gz
path source_lut: config/source_lut.txt
path target_lut: config/target_lut.txt

discover sessions: [sub, ses] from dirs sub-{sub}/ses-{ses}
require raw_dwi count>=2 per [sub, ses]
require reverse_b0 count=1 per [sub, ses]
require t1w count=1 per [sub, ses]

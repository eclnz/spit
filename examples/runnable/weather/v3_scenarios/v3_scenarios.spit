# Version 3: what if it were warmer or cooler? Each site's mean under each
# scenario, built from a shared library, with files whose paths come from other files'.
types: standard
use stats: ../shared/stats.spit [nonempty, average, what_if]

dimensions: [region, site, day, scenario]

source:
    reading: Readings .csv [region, site, day] @check(rows(5))
    calibration: Offset .txt [region, site]
    location: Site .json [region, site]
    # The note takes the location's dimensions from its path rule below.
    location_note: Text .txt
    shift: Shift .json [scenario]
    # A script kept beside this pipeline; editing it reruns the jobs that read it.
    tabulate: Script .py here
    shifter: Script .py here

path:
    reading: {region}/{site}/{day}.csv
    calibration: {region}/{site}/calibration.txt
    location: {region}/{site}/site.json
    # The note shares the location's folder and name, and differs by its extension.
    location_note: {location$dir}/{location$stem}.txt
    shift: scenarios/{scenario}.json
    tabulate: tabulate.py
    shifter: shift.py

check:
    rows(n): sh -c 'test "$(wc -l < "$1")" -eq "$2"' sh {@path} {n}

default:
    entities: {@key}={@value} separated "_"
    path: {@stage}/{@product}[/{@entities}]
    ext: .txt
    check: stats.nonempty
    uses: awk

# Paths spell the `site` dimension as `place`; its identity stays `site`.
entities site: place

tool:
    awk
    python

# The commands of operations declared below, in one block.
command:
    clean:
        awk -F, -v site={site} -v off={@scalar(offset)} \
        'FNR > 1 { split(FILENAME, p, "/"); d = p[length(p)]; sub(/[.]csv$/, "", d); printf "%s,%s,%s,%.1f\n", site, d, $1, $2 - off }' \
        {days} > {@output}
    # The index is written beside the series; no command names it.
    index: sh -c 'wc -l < "$1" > "$1.idx"' sh {series}
    # `<` reads the series on stdin and `>` writes the count.
    count: wc -l < {series} > {@output}
    # Two commands in turn: the second reads what the first wrote.
    order:
        sort -k3 -g -o {sorted} {board}
        uniq -c {sorted} > {counts}

resources:
    table: cores=1, memory=64M

uses:
    # Python writes the report, and awk is not used.
    write: python, !awk

anchored:
    write

stage clean:
    operation clean(days: many Readings @min(2), offset: Offset) -> Readings .csv
    product cleaned = clean(reading @vary(day), calibration)

    operation index(series: Readings) -> Index .idx
    product indexed = index(cleaned)
    # The index sits beside the series it was made from.
    path indexed: {cleaned$dir}/{cleaned$stem}.csv.idx

    operation count(series: Readings) -> Count
    product counts = count(cleaned)

stage means:
    stage site:
        operation mean_of(series: Readings) -> Mean
        command mean_of: awk -F, '{ s += $4; n += 1 } END { printf "%.2f\n", s / n }' {series} > {@output}
        product site_mean = mean_of(cleaned)

    stage region:
        product region_mean = stats.average(site_mean @vary(site))

    # The sidecar is an input like any other file.
    operation card(location: Site, note: Text) -> Text
    command card: cat {note} {location} > {@output}
    product cards = card(location, location_note)

stage scenarios:
    # `@each` runs the call once for each scenario; the sites keep their own.
    product outcome = stats.what_if(
        shifter,
        site_mean,
        shift @each(scenario)
    )

stage report:
    operation table(script: Script, means: many Mean) -> Table .tsv
    command table: python3 {script} join {@join(means)} --places {means[site]} --scenarios {means[scenario]} > {@output}
    product board = table(tabulate, outcome @vary(region, site, scenario))

    operation listed(script: Script, means: many Mean) -> Table .tsv
    command listed: python3 {script} list {@list(means)} --places {means[site]} --scenarios {means[scenario]} > {@output}
    product listing = listed(tabulate, outcome @vary(region, site, scenario))

    # The counts may be empty, so they are not checked for that.
    operation order(board: Table) -> (sorted: Table .tsv, counts: Table .txt @check(!stats.nonempty))
    product ordered, tallies = order(board)

    # A folder holds a copy of every outcome.
    operation bundle(means: many Mean) -> Bundle /
    command bundle: cp {means} {@output}/
    product bundled = bundle(outcome @vary(region, site, scenario))

    # The indexed bundle starts as a copy of the bundle, and adds its own index to it.
    operation catalogue(bundle: Bundle) -> Catalogue / from bundle
    command catalogue: sh -c 'echo "$(ls "$1" | wc -l) outcomes" > "$1/index.txt"' sh {@output}
    product catalogued = catalogue(bundled)

    operation write(board: Table) -> (report: Text .txt, summary: Text .txt)
    command write: python3 {@here}/report.py {board} {report$dir} {report$stem}
    product written, written_summary = write(board)
    # The summary sits beside the report, from the report's folder and name.
    path written_summary: {written$dir}/{written$stem}_summary.txt

stage pack:
    # Each site's pack is one folder holding two files that other jobs write.
    operation describe(mean: Mean) -> Text
    command describe: sh -c 'echo "mean $(cat "$1")" > "$2"' sh {mean} {@output}
    product described = describe(site_mean)

    operation label(card: Text) -> Text
    command label: cp {card} {@output}
    product labelled = label(cards)

    operation pack(mean: Text, card: Text) -> Pack / view
    product packed = pack(described, labelled)

    path:
        described: pack/{@entities}/mean.txt
        labelled: pack/{@entities}/card.txt
        packed: pack/{@entities}

    # The reader is given the pack's folder, and waits for both files in it.
    operation read_pack(pack: Pack) -> Text
    command read_pack: sh -c 'cat "$1/mean.txt" "$1/card.txt" > "$2"' sh {pack} {@output}
    product read = read_pack(packed)

source reading : Reading<Raw> [site, device, window, sample]
source gain [site, device]
source baseline : Baseline [site, window]
source target : Target [site]

operation normalize(reading: Reading<Raw>, gain, baseline: Baseline) -> Reading<Normalized>
normalized = normalize(reading, gain, baseline)

operation inspect(reading: Reading<Raw>) -> Flag
checked = inspect(reading)

operation mean(readings: many Reading<Normalized>) -> Reading<Normalized>
window_mean = mean(normalized @ vary(sample))

operation score(reading: Reading<Normalized>, target: Target) -> Score
scored = score(window_mean, target)

device_mean = mean(window_mean @ vary(window))
site_mean = mean(device_mean @ vary(device))

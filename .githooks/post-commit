#!/bin/sh

set -- ocaml/src ocaml/bin ocaml/tests ocaml/tools ocaml/.ocamlformat pyproject.toml uv.lock runner/src runner/tests release
pending=$(git status --porcelain=v1 --untracked-files=normal -- "$@") || exit 1
if [ -n "$pending" ]; then
    printf '%s\n' 'Post-commit formatting skipped because source or formatting configuration has uncommitted changes.' >&2
    exit 0
fi

failed=0
./ocaml/format.sh || failed=1
uv run --locked --isolated --only-group format ruff format runner/src runner/tests ocaml/tests ocaml/tools release || failed=1

if ! git diff --quiet -- "$@"; then
    printf '%s\n' 'Post-commit formatting left fixes in the working tree. Review them before committing.' >&2
fi
if [ "$failed" -ne 0 ]; then
    printf '%s\n' 'Post-commit formatting failed. Install ocamlformat 0.30.0 and the Python formatting tools.' >&2
fi
exit "$failed"
